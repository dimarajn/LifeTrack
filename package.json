{
  "name": "lifetrack-monorepo",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate --schema=./backend/prisma/schema.prisma",
    "build": "npx prisma generate --schema=./backend/prisma/schema.prisma && cd frontend && npm install && npm run build",
    "start": "cd backend && node server.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
